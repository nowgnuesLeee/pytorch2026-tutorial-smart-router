# .env.example을 .env로 복사해 값을 채우세요:  cp .env.example .env
# .env는 .gitignore에 있으니 키를 넣어도 커밋되지 않습니다.
# (.env.example은 커밋되는 파일이니 여기에 키를 넣지 마세요.)

# 토큰 팩토리 OpenAI 호환 엔드포인트와 키
LLM_BASE_URL=https://<토큰-팩토리-엔드포인트>/v1
LLM_API_KEY=<본인-키>

# 작은 모델과 큰 모델 이름
SMALL_MODEL=<작은-모델-이름>
BIG_MODEL=<큰-모델-이름>

# 1M 토큰당 가격(USD). 토큰 팩토리 가격표를 보고 채우세요.
SMALL_PRICE_IN=0.1
SMALL_PRICE_OUT=0.4
BIG_PRICE_IN=2.0
BIG_PRICE_OUT=8.0
